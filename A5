connection = sqlite3.connect(":memory:")
cursor = connection.cursor()

cursor.execute("""
CREATE TABLE complaints (
    id INTEGER PRIMARY KEY,
    station TEXT,
    day TEXT,
    complaint TEXT
)
""")

# Insert 50,000 complaints
stations = [f"Station{i}" for i in range(1, 101)]

data = []

for i in range(50000):
    station = stations[i % 100]
    day = f"2026-11-{(i % 30) + 1:02d}"

    data.append((
        station,
        day,
        complaints[i % 50]
    ))

cursor.executemany("""
INSERT INTO complaints (station, day, complaint)
VALUES (?, ?, ?)
""", data)

connection.commit()

query = """
SELECT * FROM complaints
WHERE station = ? AND day = ?
"""

parameters = ("Station10", "2026-11-10")


# Measure query before indexing
start = time.perf_counter()

for i in range(100):
    cursor.execute(query, parameters)
    cursor.fetchall()

before_time = time.perf_counter() - start

print("Time Before Index:", round(before_time, 6), "seconds")


# Create index
cursor.execute("""
CREATE INDEX idx_station_day
ON complaints(station, day)
""")

connection.commit()


# Measure query after indexing
start = time.perf_counter()

for i in range(100):
    cursor.execute(query, parameters)
    cursor.fetchall()

after_time = time.perf_counter() - start

print("Time After Index:", round(after_time, 6), "seconds")

if after_time > 0:
    improvement = (
        (before_time - after_time) / before_time
    ) * 100

    print("Performance Improvement:",
          round(improvement, 2), "%")


# Check query execution plan
