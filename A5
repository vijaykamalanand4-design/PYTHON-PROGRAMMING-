# -----------------------------------
# B4.1 - TEXT SUMMARISER
# -----------------------------------

STOPWORDS = {
    "the", "is", "are", "was", "were", "and", "a",
    "an", "of", "to", "in", "from", "not", "no",
    "on", "this", "that", "it", "my", "with"
}

def important_summary(text, k=2):
    sentences = re.split(r'(?<=[.!?])\s+', text.strip())

    words = re.findall(r'\b[a-z]+\b', text.lower())

    frequency = Counter(
        word for word in words
        if word not in STOPWORDS
    )

    ranked = sorted(
        enumerate(sentences),
        key=lambda item: sum(
            frequency[word]
            for word in re.findall(r'\b[a-z]+\b', item[1].lower())
        ),
        reverse=True
    )

    selected = sorted(ranked[:k], key=lambda item: item[0])

    return " ".join(sentence for _, sentence in selected)


def first_k_summary(text, k=2):
    sentences = re.split(r'(?<=[.!?])\s+', text.strip())

    return " ".join(sentences[:k])


# Compare summaries on 50 complaints
