first_quality = 0

for i, complaint in enumerate(complaints):

    important = important_summary(complaint)
    first = first_k_summary(complaint)

    print("\nComplaint:", i + 1)
    print("Important Words Summary:", important)
    print("First K Summary:", first)

    # Measure coverage of important non-stop words
    words = set(re.findall(r'\b[a-z]+\b', complaint.lower()))
    important_words = words - STOPWORDS

    important_quality += len(
        important_words.intersection(
            set(re.findall(r'\b[a-z]+\b', important.lower()))
        )
    )

    first_quality += len(
        important_words.intersection(
            set(re.findall(r'\b[a-z]+\b', first.lower()))
        )
    )

print("\nImportant Summary Coverage:", important_quality)
print("First K Summary Coverage:", first_quality)


