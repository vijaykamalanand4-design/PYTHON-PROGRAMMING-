# Performance testing
def generate_contacts(n):

    data = []

    for i in range(n):
        number = str(9000000000 + (i % max(1, n // 2)))

        data.append({
            "name": "Person " + str(i),
            "phone": number,
            "email": "person" + str(i) + "@gmail.com"
        })

    return data


print("\nPERFORMANCE TESTING")
print("-" * 45)

for size in [1000, 100000]:

    test_data = generate_contacts(size)

    start = time.perf_counter()

    merged_result = merge_contacts(test_data)

    end = time.perf_counter()

    elapsed = end - start

    print("Input Contacts:", size)
    print("Merged Contacts:", len(merged_result))
    print("Execution Time:", round(elapsed, 6), "seconds")
    print("-" * 45)

