# Function to normalize phone numbers
def normalize_phone(phone):
    if not phone:
        return ""

    digits = ''.join(ch for ch in str(phone) if ch.isdigit())

    if digits.startswith("91") and len(digits) == 12:
        digits = digits[2:]

    return digits


# Function to normalize names
def normalize_name(name):
    if not name:
        return ""

    return " ".join(name.lower().strip().split())


# Function to merge contacts
def merge_contacts(contacts):

    merged = {}

    for contact in contacts:

        name = normalize_name(contact.get("name", ""))
        phone = normalize_phone(contact.get("phone", ""))
        email = contact.get("email", "").strip().lower()

        # Skip contacts without a phone number
        if not phone:
            continue

        # Create dictionary entry if not present
        if phone not in merged:
            merged[phone] = {
                "names": set(),
                "phones": set(),
                "emails": set()
            }

        # Add unique details
        if name:
            merged[phone]["names"].add(name)

        merged[phone]["phones"].add(phone)

        if email:
            merged[phone]["emails"].add(email)

    return merged


# Function to display contacts
def display_contacts(merged):

    print("\nMERGED CONTACT LIST")
    print("-" * 45)

    for phone, details in merged.items():

        print("Names:", ", ".join(sorted(details["names"])))
        print("Phone Numbers:", ", ".join(sorted(details["phones"])))
        print("Emails:", ", ".join(sorted(details["emails"])))
        print("-" * 45)


