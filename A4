
import os

# Validate email
def validate_email(email):
    email = email.strip().lower()

    if " " in email or email.count("@") != 1:
        return False

    username, domain = email.split("@")

    if not username or not domain:
        return False

    if "." not in domain:
        return False

    if domain.startswith(".") or domain.endswith("."):
        return False

    return True


# Read department file
def read_file(filename, errors):
    try:
        with open(filename, "r", encoding="utf-8") as file:
            return file.readlines()

    except FileNotFoundError:
        errors.append("Missing file: " + filename)

    except (PermissionError, OSError) as error:
        errors.append("File error: " + str(error))

    return []


# Process registrations
def process_contacts(lines, department, seen, errors):

    master = []
    events = {}

    for line_no, line in enumerate(lines, start=1):

        try:
            fields = line.strip().split(",", 4)

            if len(fields) != 5:
                errors.append(
                    f"{department} Line {line_no}: Damaged line"
                )
                continue

            reg_no, name, dept, email, event_text = fields

            reg_no = reg_no.strip()
            name = name.strip()
            dept = dept.strip()
            email = email.strip().lower()

            if not all([reg_no, name, dept, event_text.strip()]):
                errors.append(
                    f"{department} Line {line_no}: Missing field"
                )
                continue

            if not validate_email(email):
                errors.append(
                    f"{department} Line {line_no}: Invalid email"
                )
                continue

            if reg_no in seen:
                errors.append(
                    f"{department} Line {line_no}: Duplicate registration"
                )
                continue

            seen.add(reg_no)

            student = {
                "reg_no": reg_no,
                "name": name,
                "department": dept,
                "email": email,
                "events": [
                    event.strip()
                    for event in event_text.split(";")
                    if event.strip()
                ]
            }

            master.append(student)

            for event in student["events"]:
                if event not in events:
                    events[event] = []

                events[event].append(student)

        except Exception as error:
            errors.append(
                f"{department} Line {line_no}: {error}"
            )

    return master, events


# Write output files
def write_outputs(master, events, errors):

    os.makedirs("output", exist_ok=True)

    try:
        # Master list
        with open("output/master_list.txt", "w",
                  encoding="utf-8") as file:

            for student in master:
                file.write(
                    f"{student['reg_no']}, "
                    f"{student['name']}, "
                    f"{student['department']}, "
                    f"{student['email']}, "
                    f"{';'.join(student['events'])}\n"
                )

        # Event-wise participant lists
        for event, students in events.items():

            filename = event.replace("/", "_")

            with open(f"output/{filename}.txt", "w",
                      encoding="utf-8") as file:

                for student in students:
                    file.write(
                        f"{student['reg_no']}, "
                        f"{student['name']}, "
                        f"{student['email']}\n"
                    )

        # Summary report
        with open("output/summary_report.txt", "w",
                  encoding="utf-8") as file:

            file.write("COLLEGE FEST SUMMARY REPORT\n")
            file.write("---------------------------\n")
            file.write(
                f"Total Valid Registrations: {len(master)}\n"
            )
            file.write(f"Total Events: {len(events)}\n")

            for event, students in events.items():
                file.write(
                    f"{event}: {len(students)} participants\n"
                )

        # Error log
        with open("output/error_log.txt", "w",
                  encoding="utf-8") as file:

            for error in errors:
                file.write(error + "\n")

        print("\nAll output files generated successfully!")

    except OSError as error:
        print("Output file error:", error)


# Main program
def main():

    departments = ["CSE", "AIDS", "ECE", "EEE", "MECH"]

    seen = set()
    master = []
    all_events = {}
    errors = []

    for department in departments:

        filename = f"input/{department}.txt"

        lines = read_file(filename, errors)

        records, events = process_contacts(
            lines, department, seen, errors
        )

        master.extend(records)

        for event, students in events.items():

            if event not in all_events:
                all_events[event] = []

            all_events[event].extend(students)

    write_outputs(master, all_events, errors)

    print("\nCOLLEGE FEST REGISTRATION REPORT")
    print("--------------------------------")
    print("Valid Registrations:", len(master))
    print("Total Events:", len(all_events))
    print("Errors Found:", len(errors))
    print("Output Folder: output")


if __name__ == "__main__":
    main()

